---
interface Props {
  id?: string;
  title?: string;
  meta?: string;
  /** Use `h1` when the section title is the page title. */
  level?: 'h1' | 'h2';
}

const { id, title, meta, level = 'h2' } = Astro.props;
const Heading = level;
---

<section id={id} class="section">
  {
    title && (
      <div class="head">
        <Heading class="title">{title}</Heading>
        {meta && <p class="mono-label">{meta}</p>}
      </div>
    )
  }
  <slot />
</section>

<style>
  .section {
    padding: 64px 0;
    border-bottom: 1px solid var(--ink);
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }
  .title {
    font-size: 44px;
  }
  .head p {
    margin: 0;
  }
  @media (max-width: 640px) {
    .title {
      font-size: 34px;
    }
  }
</style>
