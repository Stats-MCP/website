---
import CopyButton from '@/components/ui/CopyButton.astro';

interface Props {
  code: string;
  copyLabel: string;
  copiedLabel: string;
}

const { code, copyLabel, copiedLabel } = Astro.props;
---

<div class="code">
  <pre>{code}</pre>
  <CopyButton text={code} label={copyLabel} copiedLabel={copiedLabel} />
</div>

<style>
  .code {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }
  pre {
    margin: 0;
    width: 100%;
    padding: 18px;
    background: var(--ink);
    color: var(--paper);
    font-size: 14px;
    white-space: pre-wrap;
    word-break: break-all;
  }
</style>
