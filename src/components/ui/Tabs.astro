---
export interface TabItem {
  value: string;
  label: string;
  /** Decorative image URL shown before the label, for example a flag. */
  icon?: string;
  /** Full name when the label is short, for example a country code. */
  title?: string;
}

interface Props {
  group: string;
  label: string;
  items: TabItem[];
  selected: string;
  /** Unique per tablist when several tablists share a group. */
  idPrefix?: string;
  /** False when the page preselects a value that a stored choice must not override. */
  restore?: boolean;
  /** "wrap" shows every tab on several rows instead of one scrolling row. */
  layout?: 'scroll' | 'wrap';
}

const {
  group,
  label,
  items,
  selected,
  idPrefix = group,
  restore = true,
  layout = 'scroll'
} = Astro.props;
---

<div
  class:list={['tabs', layout]}
  role="tablist"
  aria-label={label}
  data-tab-restore={String(restore)}>
  {
    items.map((item) => (
      <button
        type="button"
        role="tab"
        id={`tab-${idPrefix}-${item.value}`}
        aria-controls={`panel-${idPrefix}-${item.value}`}
        aria-selected={item.value === selected ? 'true' : 'false'}
        tabindex={item.value === selected ? 0 : -1}
        data-tab-group={group}
        data-tab-value={item.value}
        title={item.title}
        aria-label={item.title}>
        {item.icon && <img src={item.icon} alt="" width="20" height="15" />}
        {item.label}
      </button>
    ))
  }
</div>

<script>
  import { initTabs } from '@/scripts/tabs';

  initTabs();
</script>

<style>
  .tabs {
    display: flex;
    overflow-x: auto;
    scrollbar-width: thin;
    border: 1px solid var(--ink);
  }
  button {
    flex: none;
    white-space: nowrap;
    font: inherit;
    font-size: 14px;
    min-height: 44px;
    padding: 12px 18px;
    border: 0;
    border-right: 1px solid var(--ink);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }
  button:last-child {
    border-right: 0;
  }
  button img {
    margin-right: 8px;
    vertical-align: -2px;
    box-shadow: 0 0 0 1px var(--rule);
  }
  .wrap {
    flex-wrap: wrap;
    overflow: hidden;
  }
  .wrap button {
    flex: 1 0 auto;
    padding: 12px 12px;
    border-bottom: 1px solid var(--ink);
    margin: 0 -1px -1px 0;
  }
  button[aria-selected='true'] {
    background: var(--ink);
    color: var(--paper);
    font-weight: 600;
  }
</style>
