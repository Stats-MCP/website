---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  /** `group:value` of a tab to select when the link is used. */
  activate?: string;
}

const { href, variant = 'secondary', activate } = Astro.props;
---

<a class:list={['button', 'pressable', variant]} href={href} data-tab-activate={activate}><slot /></a>

<script>
  import { initTabs } from '@/scripts/tabs';

  initTabs();
</script>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 12px 20px;
    font-weight: 500;
    text-decoration: none;
  }
  .primary {
    background: var(--accent);
    color: var(--surface);
    font-weight: 600;
  }
  .primary:hover {
    color: var(--surface);
    background: var(--ink);
  }
  .secondary {
    border: 1px solid var(--ink);
  }
  .secondary:hover {
    color: var(--ink);
    background: var(--surface);
  }
</style>
