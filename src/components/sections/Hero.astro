---
import CopyButton from '@/components/ui/CopyButton.astro';
import Flag from '@/components/ui/Flag.astro';
import LinkButton from '@/components/ui/LinkButton.astro';
import Sparkline from '@/components/ui/Sparkline.astro';
import TabPanel from '@/components/ui/TabPanel.astro';
import Tabs from '@/components/ui/Tabs.astro';
import { endpoint, statusKey, type Country } from '@/data/countries';
import { repoUrl } from '@/data/site';
import { type Locale , localized } from '@/i18n/locales';
import { fill, ui } from '@/i18n/ui';
import { byName } from '@/lib/country-order';
import { countryTabItems } from '@/lib/country-tabs';
import { localePath } from '@/i18n/urls';
import { keepNumbersTogether, splitHighlight } from '@/lib/highlight';
import { formatPeriod } from '@/lib/periods';

interface Props {
  locale: Locale;
  countries: Country[];
  selected: Country;
  /** False on a country page, where the page's country must win over a stored choice. */
  restore?: boolean;
  /** Heading and lead of a country page; the home page computes its own. */
  title?: string;
  lead?: string;
}

const { locale, countries, selected, restore = true } = Astro.props;
const t = ui[locale];
const live = countries.filter((country) => country.status === 'live');
const counts = {
  countries: String(live.filter((country) => country.id !== 'eu').length),
  offices: String(live.length)
};
const title = Astro.props.title ?? fill(t.hero.title, counts);
const lead = Astro.props.lead ?? fill(t.hero.lead, counts);
const coverage = byName(live, locale)
  .map((country) => localized(country.name, locale))
  .join(' · ');
const tabs = countryTabItems(countries, locale, { compact: true });
const toolNames = t.howItWorks.steps.map((step) => step.tool);
const formatValue = (decimals = 1) => {
  const format = new Intl.NumberFormat(locale, {
    minimumFractionDigits: decimals,
    maximumFractionDigits: decimals
  });
  return (value: number) => format.format(value);
};
---

<section class="hero" id="top">
  <div class="intro">
    <p class="eyebrow">{t.hero.eyebrow}</p>
    <h1>{title}</h1>
    <p class="lead">{lead}</p>

    <div class="switch">
      <Tabs
        group="country"
        idPrefix="hero"
        label={t.hero.countryTabs}
        items={tabs}
        selected={selected.id}
        restore={restore}
        layout="wrap"
      />
      {
        countries.map((country) => (
          <TabPanel group="country" idPrefix="hero" value={country.id} selected={selected.id}>
            <p class="picked">
              <Flag code={country.code} />
              <span>
                <strong>{localized(country.name, locale)}</strong> · {localized(country.office.fullName, locale)}
              </span>
            </p>
            <div class="endpoint">
              <span class="mono-label">{t.hero.endpointLabel}</span>
              <code>{endpoint(country)}</code>
              <span class:list={['status', statusKey(country)]}>
                {t.hero.status[statusKey(country)]}
              </span>
              {country.status === 'live' && (
                <CopyButton text={endpoint(country)} label={t.copy.copy} copiedLabel={t.copy.copied} />
              )}
            </div>
            {country.limited && <p class="note">{t.hero.limitedNote}</p>}
          </TabPanel>
        ))
      }
    </div>

    <div class="actions">
      <LinkButton href="#connect" variant="primary" activate="client:claude">
        {t.hero.addToClaude}
      </LinkButton>
      <LinkButton href="#connect" activate="client:chatgpt">{t.hero.addToChatgpt}</LinkButton>
    </div>
    <p class="coverage">{coverage}</p>
    <p class="promise">
      <a href={localePath(locale, 'privacy/')}>{t.hero.privacy}</a>
    </p>
  </div>

  <figure class="figure">
    <figcaption class="mono-label">{t.figure.caption}</figcaption>
    {
      countries.map((country) => (
        <TabPanel
          group="country"
          idPrefix="hero-figure"
          value={country.id}
          selected={selected.id}
          labelledBy={`tab-hero-${country.id}`}>
          {country.example ? (
            <div class="body">
              <div class="turn">
                <p class="speaker">{t.figure.you}</p>
                <p class="question">{localized(country.example.question, locale)}</p>
              </div>
              <div class="turn">
                <p class="speaker">{t.figure.assistant}</p>
                <div class="tools">
                  <span class="mono-label">
                    {fill(t.figure.toolCalls, { count: String(toolNames.length) })}
                  </span>
                  <ol aria-label={fill(t.figure.toolCalls, { count: String(toolNames.length) })}>
                    {toolNames.map((tool) => (
                      <li>
                        <code>{tool}</code>
                        <span class="check" aria-hidden="true">✓</span>
                      </li>
                    ))}
                  </ol>
                </div>
                <div class="chart">
                  <p class="mono-label">{localized(country.example.seriesLabel, locale)}</p>
                  <Sparkline
                    values={country.example.series.map((point) => point.value)}
                    formatValue={formatValue(country.example.decimals)}
                    startLabel={formatPeriod(country.example.series[0]?.period ?? '', locale)}
                    endLabel={formatPeriod(country.example.series.at(-1)?.period ?? '', locale)}
                    label={`${localized(country.example.seriesLabel, locale)}: ${country.example.series
                      .map((point) => `${formatPeriod(point.period, locale)} ${formatValue(country.example?.decimals)(point.value)}`)
                      .join(', ')}`}
                  />
                </div>
                <p class="answer">
                  {splitHighlight(keepNumbersTogether(localized(country.example.answer, locale)), keepNumbersTogether(localized(country.example.highlight, locale))).map(
                    (part) => (part.highlight ? <strong>{part.text}</strong> : part.text)
                  )}
                </p>
                <p class="source">
                  {t.figure.sourceLabel}{' '}
                  <a href={country.example.sourceUrl}>
                    {country.example.source}
                    <span aria-hidden="true"> ↗</span>
                  </a>
                </p>
              </div>
            </div>
          ) : (
            <div class="body">
              <p class="answer">
                {fill(t.figure.plannedTitle, { country: localized(country.name, locale) })}
              </p>
              <p>{fill(t.figure.plannedText, { database: country.database.name })}</p>
              <a href={repoUrl}>{t.figure.plannedLink}</a>
            </div>
          )}
        </TabPanel>
      ))
    }
  </figure>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 56px;
    padding: 64px 0 56px;
    border-bottom: 1px solid var(--ink);
  }
  .intro {
    display: flex;
    flex-direction: column;
    gap: 26px;
  }
  .eyebrow {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }
  h1 {
    font-size: 70px;
    line-height: 1.02;
    letter-spacing: -0.02em;
  }
  .lead {
    margin: 0;
    font-size: 19px;
    color: var(--muted);
    max-width: 560px;
  }
  .switch {
    border: 1px solid var(--ink);
    background: var(--surface);
  }
  .switch :global([role='tablist']) {
    border: 0;
    border-bottom: 1px solid var(--ink);
  }
  .picked {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    padding: 12px 14px 0;
    font-size: 15px;
  }
  .endpoint {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
  }
  .endpoint code {
    flex-grow: 1;
    font-size: 15px;
  }
  .status {
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    padding: 4px 8px;
    border: 1px solid currentColor;
  }
  .note {
    margin: 0;
    padding: 0 14px 14px;
    font-size: 14px;
    color: var(--muted);
  }
  .coverage {
    margin: 0;
    max-width: 560px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted);
  }
  .promise {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .status.limited {
    color: var(--warn);
    border-color: currentColor;
  }
  .status.live {
    color: var(--live);
  }
  .status.planned {
    color: var(--subtle);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .figure {
    margin: 0;
    border: 1px solid var(--ink);
    background: var(--surface);
  }
  figcaption {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--ink);
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px;
  }
  .body p {
    margin: 0;
  }
  .turn {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .speaker {
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--subtle);
  }
  .question {
    font-weight: 600;
    font-size: 18px;
  }
  .tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
  }
  .tools ol {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tools li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 8px;
    border: 1px solid var(--rule);
    font-size: 12px;
  }
  .check {
    color: var(--live);
  }
  .answer strong {
    color: var(--accent);
    font-weight: 600;
  }
  .chart {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 14px;
    border-top: 1px solid var(--rule);
  }
  .answer {
    font-family: var(--font-display);
    font-size: 22px;
    line-height: 1.35;
  }
  .source {
    font-size: 13px;
    color: var(--subtle);
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  @keyframes tick {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .intro > * {
      animation: rise 400ms var(--ease-out) both;
    }
    .intro > :nth-child(2) {
      animation-delay: 50ms;
    }
    .intro > :nth-child(3) {
      animation-delay: 100ms;
    }
    .intro > :nth-child(4) {
      animation-delay: 150ms;
    }
    .intro > :nth-child(5) {
      animation-delay: 200ms;
    }
    .tools li {
      --delay: 0ms;
      animation: fade-in 240ms var(--ease-out) var(--delay) both;
    }
    .tools li:nth-child(2) {
      --delay: 60ms;
    }
    .tools li:nth-child(3) {
      --delay: 120ms;
    }
    .tools li:nth-child(4) {
      --delay: 180ms;
    }
    .check {
      display: inline-block;
      animation: tick 200ms var(--ease-out) calc(var(--delay) + 160ms) both;
    }
  }
  @media (max-width: 980px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
    }
    h1 {
      font-size: 48px;
    }
  }
</style>
