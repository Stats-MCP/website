---
import AllCountriesBox from '@/components/sections/AllCountriesBox.astro';
import { countries, indexedTables } from '@/data/countries';
import { type Locale, localized } from '@/i18n/locales';
import { fill, ui } from '@/i18n/ui';
import { localePath } from '@/i18n/urls';
import { keepNumbersTogether } from '@/lib/highlight';
import { formatPeriod } from '@/lib/periods';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
const offices = String(countries.filter((country) => country.status === 'live').length);
const tables = `${new Intl.NumberFormat(locale).format(indexedTables(countries))}+`;

function lastPoint(id: string) {
  const country = countries.find((item) => item.id === id);
  const point = country?.example?.series.at(-1);
  if (!country?.example || !point) {
    throw new Error(`The home figure needs the ${id} example.`);
  }
  return { country, example: country.example, point };
}

const canada = lastPoint('ca');
const eu = lastPoint('eu');
if (canada.point.period !== eu.point.period) {
  throw new Error('The Canada and EU examples must end in the same period.');
}
const percent = new Intl.NumberFormat(locale, {
  style: 'percent',
  minimumFractionDigits: 1,
  maximumFractionDigits: 1
});
const comparison = {
  canada: keepNumbersTogether(percent.format(canada.point.value / 100)),
  eu: keepNumbersTogether(percent.format(eu.point.value / 100)),
  period: formatPeriod(canada.point.period, locale)
};
const sources = [canada.example, eu.example];
const shownTools = t.howItWorks.steps
  .map((step) => step.tool)
  .filter((tool) => tool !== 'get_table_metadata');
const tools = shownTools.flatMap((tool) => [`${tool} · ca`, `${tool} · eu`]);
---

<section class="hero" id="top">
  <div class="intro">
    <p class="eyebrow">{t.hero.eyebrow}</p>
    <h1>{t.home.title}</h1>
    <p class="lead">{fill(t.home.lead, { offices, tables })}</p>
    <AllCountriesBox locale={locale} connectHref="#connect" />
    <p class="promise">
      <a href={localePath(locale, 'privacy/')}>{t.hero.privacy}</a>
    </p>
  </div>

  <figure class="figure">
        <figcaption class="mono-label">{t.figure.caption}</figcaption>
        <div class="body">
          <p class="speaker">{t.figure.you}</p>
          <p class="question">{t.home.compareQuestion}</p>
          <p class="speaker">{t.figure.assistant}</p>
          <ol class="tools" role="list" aria-label={fill(t.figure.toolCalls, { count: String(tools.length) })}>
            {tools.map((tool) => (
              <li>
                <code>{tool}</code>
                <span class="check" aria-hidden="true">
                  ✓
                </span>
              </li>
            ))}
          </ol>
          <div class="cards">
            <div class="card">
              <p class="card-label">
                {localized(canada.country.name, locale)} · {comparison.period}
              </p>
              <p class="card-value">{comparison.canada}</p>
            </div>
            <div class="card">
              <p class="card-label">
                {t.home.euShort} · {comparison.period}
              </p>
              <p class="card-value">{comparison.eu}</p>
            </div>
          </div>
          <p class="answer">
            {fill(t.home.compareAnswer, comparison)}
          </p>
          <p class="source">
            {t.figure.sourceLabel}{' '}
            {sources.map((source, index) => (
              <>
                {index > 0 && ' · '}
                <a href={source.sourceUrl}>
                  {source.source}
                  <span aria-hidden="true"> ↗</span>
                </a>
              </>
            ))}
          </p>
        </div>
      </figure>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 56px;
    padding: 64px 0 56px;
    border-bottom: 1px solid var(--ink);
  }
  .intro {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .eyebrow {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }
  h1 {
    font-size: 66px;
    line-height: 1.04;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .lead {
    margin: 0;
    font-size: 19px;
    color: var(--muted);
    max-width: 560px;
  }
  .promise {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .figure {
    align-self: start;
    margin: 0;
    border: 1px solid var(--ink);
    background: var(--surface);
  }
  figcaption {
    padding: 12px 16px;
    border-bottom: 1px solid var(--ink);
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 24px;
  }
  .body p {
    margin: 0;
  }
  .speaker {
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--subtle);
  }
  .question {
    font-weight: 600;
    font-size: 18px;
  }
  .tools {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tools li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 8px;
    border: 1px solid var(--rule);
    font-size: 12px;
  }
  .check {
    color: var(--live);
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .card {
    padding: 14px;
    border: 1px solid var(--rule);
  }
  .card-label {
    font-size: 13px;
    color: var(--subtle);
  }
  .card-value {
    font-family: var(--font-display);
    font-size: 44px;
    line-height: 1.1;
    color: var(--accent);
  }
  .answer {
    font-family: var(--font-display);
    font-size: 21px;
    line-height: 1.35;
  }
  .source {
    font-size: 13px;
    color: var(--subtle);
  }
  @media (max-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }
  }
  @media (max-width: 640px) {
    .hero {
      padding: 40px 0;
    }
    h1 {
      font-size: 42px;
    }
    .card-value {
      font-size: 34px;
    }
  }
</style>
