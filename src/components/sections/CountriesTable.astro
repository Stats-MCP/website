---
import CopyButton from '@/components/ui/CopyButton.astro';
import Flag from '@/components/ui/Flag.astro';
import { byName } from '@/lib/country-order';
import Section from '@/components/ui/Section.astro';
import { endpoint, statusKey, type Country } from '@/data/countries';
import { type Locale, localized } from '@/i18n/locales';
import { ui } from '@/i18n/ui';
import { localePath } from '@/i18n/urls';
import { issuesUrl } from '@/data/site';

interface Props {
  locale: Locale;
  countries: Country[];
  id?: string;
  title?: string;
}

const { locale, countries, id, title } = Astro.props;
const t = ui[locale];
const h = t.countries.headers;
const number = new Intl.NumberFormat(locale);
const sorted = byName(countries, locale);
---

<Section id={id} title={title}>
  <ul class="phone" role="list">
    {
      sorted.map((country) => (
        <li>
          <a class="country" href={localePath(locale, `${country.slug}/`)}>
            <Flag code={country.code} />
            {localized(country.name, locale)}
          </a>
          <span class:list={['status', statusKey(country)]}>{t.hero.status[statusKey(country)]}</span>
          <div class="endpoint">
            <code class:list={[{ muted: country.status !== 'live' }]}>{endpoint(country)}</code>
            {country.status === 'live' && (
              <CopyButton
                text={endpoint(country)}
                label={t.copy.copy}
                copiedLabel={t.copy.copied}
                ariaLabel={`${t.copy.copy}: ${localized(country.name, locale)}`}
              />
            )}
          </div>
        </li>
      ))
    }
  </ul>
  <div class="scroll">
    <table>
      <thead>
        <tr>
          <th scope="col">{h.code}</th>
          <th scope="col">{h.country}</th>
          <th scope="col">{h.source}</th>
          <th scope="col">{h.languages}</th>
          <th scope="col" class="num">{h.tables}</th>
          <th scope="col">{h.licence}</th>
          <th scope="col">{h.endpoint}</th>
          <th scope="col">{h.status}</th>
          <th scope="col"><span class="visually-hidden">{t.countries.details}</span></th>
        </tr>
      </thead>
      <tbody>
        {
          sorted.map((country) => (
            <tr>
              <td class="mono">{country.code}</td>
              <td>
                <span class="country">
                  <Flag code={country.code} />
                  {localized(country.name, locale)}
                </span>
              </td>
              <td>
                <a href={country.database.url}>{country.database.name}</a>
                {country.office.name !== country.database.name && (
                  <>
                    {' · '}
                    <a href={country.office.url}>{country.office.name}</a>
                  </>
                )}
              </td>
              <td>{country.dataLanguages.join(', ')}</td>
              <td class="num">
                {country.tables === undefined ? (
                  <span class="muted">{t.countries.officeSearch}</span>
                ) : (
                  number.format(country.tables)
                )}
              </td>
              <td>
                {country.licence.url ? (
                  <a href={country.licence.url}>{localized(country.licence.label, locale)}</a>
                ) : (
                  localized(country.licence.label, locale)
                )}
              </td>
              <td>
                <div class="endpoint">
                  <code class:list={[{ muted: country.status !== 'live' }]}>{endpoint(country)}</code>
                  {country.status === 'live' && (
                    <CopyButton
                      text={endpoint(country)}
                      label={t.copy.copy}
                      copiedLabel={t.copy.copied}
                      ariaLabel={`${t.copy.copy}: ${localized(country.name, locale)}`}
                    />
                  )}
                </div>
              </td>
              <td class:list={['status', statusKey(country)]}>{t.hero.status[statusKey(country)]}</td>
              <td>
                <a href={localePath(locale, `${country.slug}/`)}>
                  {t.countries.details}
                  <span aria-hidden="true"> →</span>
                </a>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <p class="propose">
    {t.countries.propose}{' '}
    <a href={issuesUrl}>{t.countries.proposeLink}</a>
  </p>
</Section>

<style>
  .scroll {
    position: relative;
    overflow-x: auto;
  }
  table {
    width: 100%;
    min-width: 900px;
    border-collapse: collapse;
    font-size: 15px;
  }
  th {
    text-align: left;
    padding: 10px 12px 10px 0;
    border-bottom: 2px solid var(--ink);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    color: var(--subtle);
  }
  td {
    padding: 16px 12px 16px 0;
    border-bottom: 1px solid var(--rule);
  }
  .mono {
    font-family: var(--font-mono);
  }
  .endpoint {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .endpoint code {
    font-family: var(--font-mono);
    font-size: 14px;
    white-space: nowrap;
  }
  .phone {
    display: none;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 2px solid var(--ink);
  }
  .phone li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 8px 12px;
    align-items: center;
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
  }
  .phone .country {
    font-weight: 600;
  }
  .phone .endpoint {
    grid-column: 1 / -1;
    justify-content: space-between;
  }
  .phone .endpoint code {
    min-width: 0;
    overflow-wrap: anywhere;
    white-space: normal;
  }
  @media (max-width: 640px) {
    .phone {
      display: block;
    }
    .scroll {
      display: none;
    }
  }
  .num {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .country {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .muted {
    color: var(--subtle);
  }
  .status.live {
    color: var(--live);
    font-weight: 600;
  }
  .status.limited {
    color: var(--warn);
    font-weight: 600;
  }
  .status.planned {
    color: var(--subtle);
  }
  .propose {
    margin: 0;
    color: var(--muted);
  }
</style>
