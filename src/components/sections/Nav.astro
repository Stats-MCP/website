---
import { localeNames, localeTags, locales, type Locale } from '@/i18n/locales';
import { ui } from '@/i18n/ui';
import { localePath } from '@/i18n/urls';
import LogoMark from '@/components/ui/LogoMark.astro';
import { repoUrl } from '@/data/site';

interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;
const t = ui[locale].nav;
const home = localePath(locale);
const links = [
  { href: `${home}#how`, label: t.howItWorks },
  { href: `${home}#connect`, label: t.connect },
  { href: `${home}#countries`, label: t.countries },
  { href: `${home}#faq`, label: t.faq }
];
---

<nav class="nav" aria-label="Main">
  <a class="brand" href={home}><LogoMark size={30} />StatsMCP</a>
  <span class="mono-label tagline">{t.tagline}</span>
  <div class="spacer"></div>
  <ul class="links">
    {
      links.map((link) => (
        <li>
          <a href={link.href}>{link.label}</a>
        </li>
      ))
    }
  </ul>
  <details class="languages" data-language-menu>
    <summary aria-label={`${t.language}: ${localeNames[locale]}`}>
      <span class="code">{locale.toUpperCase()}</span>
      <span class="name">{localeNames[locale]}</span>
      <svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg>
    </summary>
    <ul aria-label={t.language}>
      {
        locales.map((code) => (
          <li>
            <a
              href={localePath(code, path)}
              hreflang={localeTags[code]}
              lang={localeTags[code]}
              aria-current={code === locale ? 'page' : undefined}>
              <span class="code">{code.toUpperCase()}</span>
              {localeNames[code]}
            </a>
          </li>
        ))
      }
    </ul>
  </details>
  <a class="github pressable" href={repoUrl}>{t.github}</a>
</nav>

<script>
  for (const menu of document.querySelectorAll<HTMLDetailsElement>('[data-language-menu]')) {
    document.addEventListener('click', (event) => {
      if (menu.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
    });
    menu.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !menu.open) return;
      menu.open = false;
      menu.querySelector('summary')?.focus();
    });
  }
</script>

<style>
  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 22px;
    padding: 22px 0;
    border-bottom: 2px solid var(--ink);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 600;
    text-decoration: none;
  }
  .spacer {
    flex-grow: 1;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .links a {
    font-size: 15px;
    text-decoration: none;
  }
  .languages {
    position: relative;
  }
  .languages summary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 12px;
    border: 1px solid var(--ink);
    font-size: 14px;
    cursor: pointer;
    list-style: none;
  }
  .languages summary::-webkit-details-marker {
    display: none;
  }
  .languages[open] summary {
    background: var(--ink);
    color: var(--paper);
  }
  .languages ul {
    position: absolute;
    z-index: 20;
    top: calc(100% + 6px);
    right: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    width: max-content;
    max-width: min(420px, calc(100vw - 32px));
    border: 1px solid var(--ink);
    background: var(--paper);
  }
  .languages li {
    display: flex;
  }
  .languages ul a {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 0 14px;
    font-size: 15px;
    text-decoration: none;
    white-space: nowrap;
  }
  .languages ul a:hover,
  .languages ul a:focus-visible {
    background: var(--surface);
  }
  .languages ul a[aria-current='page'] {
    background: var(--ink);
    color: var(--paper);
  }
  .code {
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .languages ul .code {
    min-width: 22px;
    color: inherit;
    opacity: 0.7;
  }
  .github {
    background: var(--ink);
    color: var(--paper);
    padding: 11px 14px;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
  }
  .github:hover {
    color: var(--paper);
    background: var(--accent);
  }
  @media (max-width: 760px) {
    .tagline,
    .links,
    .languages summary .name {
      display: none;
    }
  }
</style>
