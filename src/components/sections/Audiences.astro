---
import Section from '@/components/ui/Section.astro';
import type { Locale } from '@/i18n/locales';
import { ui } from '@/i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale].audiences;
---

<Section id="audiences" title={t.title}>
  <ul class="audiences">
    {
      t.items.map((item) => (
        <li>
          <h3>{item.who}</h3>
          <p>{item.text}</p>
          <p class="prompt">
            <q>{item.prompt}</q>
          </p>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .audiences {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    border-top: 1px solid var(--ink);
  }
  li {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px 24px 24px 0;
    border-bottom: 1px solid var(--rule);
  }
  h3 {
    font-size: 26px;
  }
  p {
    margin: 0;
  }
  .prompt {
    margin-top: auto;
    padding-top: 8px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
  }
</style>
