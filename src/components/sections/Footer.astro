---
import type { Locale } from '@/i18n/locales';
import { ui } from '@/i18n/ui';
import { localePath } from '@/i18n/urls';
import { countries } from '@/data/countries';
import { docsUrl, npmUrl, repoUrl, securityUrl } from '@/data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
const home = localePath(locale);
const localPackage = countries.find((country) => country.localPackage)?.localPackage;
const columns = [
  {
    title: t.footer.product,
    links: [
      { href: `${home}#how`, label: t.nav.howItWorks },
      { href: `${home}#connect`, label: t.nav.connect },
      { href: `${home}#countries`, label: t.nav.countries },
      { href: `${home}#faq`, label: t.nav.faq }
    ]
  },
  {
    title: t.footer.openSource,
    links: [
      { href: repoUrl, label: 'GitHub' },
      ...(localPackage ? [{ href: npmUrl(localPackage), label: 'npm' }] : []),
      { href: docsUrl, label: t.footer.documentation }
    ]
  },
  {
    title: t.footer.legal,
    links: [
      { href: localePath(locale, 'licences/'), label: t.footer.licences },
      { href: localePath(locale, 'privacy/'), label: t.footer.privacy },
      { href: securityUrl, label: t.footer.security }
    ]
  }
];
---

<footer class="footer">
  <div class="about">
    <p class="brand">StatsMCP</p>
    <p>{t.footer.disclaimer}</p>
  </div>
  {
    columns.map((column) => (
      <div class="column">
        <p class="title">{column.title}</p>
        <ul>
          {column.links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</footer>

<style>
  .footer {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 28px;
    padding: 40px 0 56px;
    font-size: 14px;
    color: var(--muted);
  }
  p {
    margin: 0;
  }
  .brand {
    font-family: var(--font-display);
    font-size: 22px;
    color: var(--ink);
    margin-bottom: 8px;
  }
  .title {
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 8px;
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
</style>
