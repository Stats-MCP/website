---
import { isIndexable } from '@/i18n/indexing';
import { localeTags, type Locale } from '@/i18n/locales';
import { indexingRules } from '@/i18n/site-indexing';
import { localePath } from '@/i18n/urls';

interface Props {
  title: string;
  description: string;
  /** Locale-independent path, for example `slovenia/`. */
  path: string;
  locale: Locale;
  ogImage: string;
  countrySlug?: string;
  jsonLd?: object[];
  languages: readonly Locale[];
}

const { title, description, path, locale, ogImage, countrySlug, jsonLd = [], languages } = Astro.props;
const absolute = (value: string) => new URL(value, Astro.site).href;
const canonical = absolute(localePath(locale, path));
const indexable = isIndexable(indexingRules, locale, countrySlug);
const ogLocale = (tag: string) => tag.replace('-', '_');
const jsonLdText = (item: object) => JSON.stringify(item).replaceAll('<', '\\u003c');
const imageUrl = absolute(ogImage);
const indexedLanguages = languages.filter((code) => isIndexable(indexingRules, code, countrySlug));
const markdownPaths = ['', 'about/', 'contact/'];
const markdownUrl = locale === 'en' && markdownPaths.includes(path) ? `/${path}index.md` : undefined;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{
  indexedLanguages.map((code) => (
    <link rel="alternate" hreflang={localeTags[code]} href={absolute(localePath(code, path))} />
  ))
}
<link rel="alternate" hreflang="x-default" href={absolute(localePath('en', path))} />
<meta name="robots" content={indexable ? 'index, follow' : 'noindex, follow'} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="StatsMCP" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta property="og:locale" content={ogLocale(localeTags[locale])} />
{
  languages
    .filter((code) => code !== locale)
    .map((code) => <meta property="og:locale:alternate" content={ogLocale(localeTags[code])} />)
}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={title} />
<meta name="theme-color" content="#F6F6F3" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="sitemap" href="/sitemap-index.xml" />
{markdownUrl && <link rel="alternate" type="text/markdown" href={markdownUrl} />}
<link rel="ard" href="/.well-known/ard.json" />
<link rel="ai-catalog" href="/.well-known/ai-catalog.json" />
{jsonLd.map((item) => <script type="application/ld+json" set:html={jsonLdText(item)} />)}
