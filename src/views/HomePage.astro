---
import Base from '@/layouts/Base.astro';
import Audiences from '@/components/sections/Audiences.astro';
import Connect from '@/components/sections/Connect.astro';
import CountriesGrid from '@/components/sections/CountriesGrid.astro';
import Faq from '@/components/sections/Faq.astro';
import Hero from '@/components/sections/Hero.astro';
import HowItWorks from '@/components/sections/HowItWorks.astro';
import KeyFigures from '@/components/sections/KeyFigures.astro';
import { countries } from '@/data/countries';
import { defaultCountry } from '@/lib/country-order';
import { localeTags, locales, type Locale } from '@/i18n/locales';
import { ui } from '@/i18n/ui';
import { faqData, softwareData, websiteData } from '@/lib/structured-data';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const selected = defaultCountry(countries, locale);
---

<Base
  locale={locale}
  title={ui[locale].seo.home.title}
  description={ui[locale].seo.home.description}
  path=""
  ogSlug="home"
  jsonLd={[
    websiteData(locales.map((code) => localeTags[code])),
    softwareData(),
    faqData(ui[locale].faq.items)
  ]}>
  <Hero locale={locale} countries={countries} selected={selected} />
  <KeyFigures locale={locale} />
  <Audiences locale={locale} />
  <HowItWorks locale={locale} />
  <Connect locale={locale} countries={countries} selected={selected} />
  <CountriesGrid locale={locale} countries={countries} />
  <Faq locale={locale} />
</Base>
