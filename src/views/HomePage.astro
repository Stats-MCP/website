---
import Base from '@/layouts/Base.astro';
import Audiences from '@/components/sections/Audiences.astro';
import ConnectAll from '@/components/sections/ConnectAll.astro';
import CountriesGrid from '@/components/sections/CountriesGrid.astro';
import Faq from '@/components/sections/Faq.astro';
import HomeHero from '@/components/sections/HomeHero.astro';
import HowItWorks from '@/components/sections/HowItWorks.astro';
import KeyFigures from '@/components/sections/KeyFigures.astro';
import TryAsking from '@/components/sections/TryAsking.astro';
import { countries } from '@/data/countries';
import { localeTags, locales, type Locale } from '@/i18n/locales';
import { ui } from '@/i18n/ui';
import { faqData, softwareData, websiteData } from '@/lib/structured-data';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<Base
  locale={locale}
  title={ui[locale].seo.home.title}
  description={ui[locale].seo.home.description}
  path=""
  ogSlug="home"
  jsonLd={[
    websiteData(locales.map((code) => localeTags[code])),
    softwareData(ui[locale].seo.home.description),
    faqData(ui[locale].faq.items)
  ]}>
  <HomeHero locale={locale} />
  <KeyFigures locale={locale} />
  <TryAsking locale={locale} />
  <Audiences locale={locale} />
  <HowItWorks locale={locale} />
  <ConnectAll locale={locale} />
  <CountriesGrid locale={locale} countries={countries} />
  <Faq locale={locale} />
</Base>
