---
import Base from '@/layouts/Base.astro';
import AllCountriesBox from '@/components/sections/AllCountriesBox.astro';
import CountriesTable from '@/components/sections/CountriesTable.astro';
import { countries } from '@/data/countries';
import type { Locale } from '@/i18n/locales';
import { fill, ui } from '@/i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
const offices = String(
  countries.filter((country) => country.status === 'live').length
);
---

<Base
  locale={locale}
  title={t.seo.countries.title}
  description={t.seo.countries.description}
  path="countries/"
  ogSlug="countries">
  <header class="intro">
    <h1>{fill(t.countries.pageTitle, { offices })}</h1>
    <p>{t.countries.pageIntro}</p>
    <AllCountriesBox locale={locale} oneOfficeHref="#offices" />
  </header>
  <h2 id="offices" class="offices">{t.connect.oneOfficeLink}</h2>
  <CountriesTable locale={locale} countries={countries} />
  <p class="note">{t.countries.tablesNote}</p>
</Base>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 56px 0 8px;
  }
  h1 {
    font-size: 56px;
    line-height: 1.05;
    text-wrap: balance;
  }
  .intro p {
    margin: 0;
    max-width: 680px;
    font-size: 19px;
    color: var(--muted);
  }
  .offices {
    margin: 56px 0 0;
    font-size: 44px;
    scroll-margin-top: 24px;
    text-wrap: balance;
  }
  .note {
    margin: 24px 0 64px;
    max-width: 760px;
    font-size: 14px;
    color: var(--subtle);
  }
  @media (max-width: 640px) {
    h1 {
      font-size: 38px;
    }
    .offices {
      font-size: 34px;
    }
  }
</style>
