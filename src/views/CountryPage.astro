---
import Base from '@/layouts/Base.astro';
import Connect from '@/components/sections/Connect.astro';
import Faq from '@/components/sections/Faq.astro';
import HowItWorks from '@/components/sections/HowItWorks.astro';
import Hero from '@/components/sections/Hero.astro';
import { countries, type Country } from '@/data/countries';
import { type Locale , localized } from '@/i18n/locales';
import { fill, ui } from '@/i18n/ui';
import { localePath } from '@/i18n/urls';
import { breadcrumbData } from '@/lib/structured-data';

interface Props {
  locale: Locale;
  country: Country;
}

const { locale, country } = Astro.props;
const seo = country.status === 'live' ? ui[locale].seo.countryLive : ui[locale].seo.countryPlanned;
const values = {
  country: localized(country.name, locale),
  database: country.database.name,
  office: country.office.name
};
const absolute = (path: string) => new URL(path, Astro.site).href;
const page = ui[locale].countryPage;
const pageValues = {
  country: localized(country.name, locale),
  office: localized(country.office.fullName, locale),
  licence: localized(country.licence.label, locale),
  tables: country.tables === undefined ? '' : new Intl.NumberFormat(locale).format(country.tables)
};
const title = fill(page.title, pageValues);
const lead = fill(country.tables === undefined ? page.leadOffice : page.leadIndexed, pageValues);
const sources = String(countries.filter((item) => item.status === 'live').length);
---

<Base
  locale={locale}
  title={fill(seo.title, values)}
  description={fill(seo.description, values)}
  path={`${country.slug}/`}
  ogSlug={country.slug}
  countrySlug={country.slug}
  jsonLd={[
    breadcrumbData([
      { name: 'StatsMCP', url: absolute(localePath(locale)) },
      { name: localized(country.name, locale), url: absolute(localePath(locale, `${country.slug}/`)) }
    ])
  ]}>
  <Hero
    locale={locale}
    countries={countries}
    selected={country}
    restore={false}
    title={title}
    lead={lead}
  />
  <HowItWorks locale={locale} />
  <Connect locale={locale} countries={countries} selected={country} restore={false} />
  <p class="all">
    <a href={localePath(locale, 'countries/')}>
      {fill(page.seeAll, { count: sources })}
      <span aria-hidden="true"> →</span>
    </a>
  </p>
  <Faq locale={locale} />
</Base>

<style>
  .all {
    margin: 0;
    padding: 32px 0;
    border-bottom: 1px solid var(--ink);
    font-family: var(--font-display);
    font-size: 24px;
  }
  .all a {
    text-decoration: none;
  }
</style>
