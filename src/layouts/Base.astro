---
import '@fontsource/newsreader/400.css';
import '@fontsource/newsreader/600.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@/styles/global.css';

import Footer from '@/components/sections/Footer.astro';
import Nav from '@/components/sections/Nav.astro';
import Seo from '@/components/seo/Seo.astro';
import { localeTags, type Locale } from '@/i18n/locales';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Locale-independent path of this page, used by the language links and SEO. */
  path: string;
  /** Slug of the Open Graph image, for example `home` → /og/home-en.png */
  ogSlug: string;
  countrySlug?: string;
  jsonLd?: object[];
}

const { locale, title, description, path, ogSlug, countrySlug, jsonLd } = Astro.props;
---

<!doctype html>
<html lang={localeTags[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo
      title={title}
      description={description}
      path={path}
      locale={locale}
      ogImage={`/og/${ogSlug}-${locale}.png`}
      countrySlug={countrySlug}
      jsonLd={jsonLd}
    />
  </head>
  <body>
    <div class="container">
      <Nav locale={locale} path={path} />
      <main>
        <slot />
      </main>
      <Footer locale={locale} />
    </div>
    <p id="copy-status" class="visually-hidden" aria-live="polite"></p>
  </body>
</html>
